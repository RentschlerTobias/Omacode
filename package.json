{
  "name": "@omacode/micromanager",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "description": "An OpenCode v2 plugin that orchestrates sub-agents, with TypeSafe Jev making the decisions",
  "workspaces": [
    "packages/*"
  ],
  "exports": {
    ".": "./src/plugin.ts",
    "./tui": "./packages/tui/src/tui.js",
    "./guard": "./src/guard/index.ts",
    "./shell": "./src/shell/index.ts",
    "./worktree": "./src/worktree/index.ts",
    "./context": "./src/context/index.ts"
  },
  "files": [
    "src",
    "skills",
    "evolver/pyproject.toml",
    "evolver/uv.lock",
    "evolver/mm_evolve"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "subagents",
    "orchestration"
  ],
  "scripts": {
    "test": "XDG_STATE_HOME=$(mktemp -d) node --test --test-timeout=30000 'test/**/*.test.ts'",
    "test:min": "XDG_STATE_HOME=$(mktemp -d) node --test --test-timeout=30000 test/guard-http.test.ts test/guard-config.test.ts test/sandbox-plugin.test.ts test/context-plugin.test.ts test/plugin-family.test.ts test/context.test.ts",
    "build:tui": "node scripts/build-tui.mjs packages/tui/src/tui.tsx packages/tui/src/tui.js",
    "typecheck": "tsc -p tsconfig.json",
    "eval": "node src/cli.ts eval",
    "export-dataset": "node src/cli.ts export-dataset",
    "bench-guards": "node src/cli.ts bench-guards",
    "bench-n7": "node src/cli.ts bench-n7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-typescript": "^7.29.0",
    "@types/node": "^24.19.0",
    "babel-preset-solid": "^1.9.16",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@omacode/core": "0.1.1",
    "@omacode/guard": "0.1.1",
    "@omacode/sandbox": "0.1.1",
    "@omacode/context": "0.1.1",
    "@omacode/state": "0.1.1",
    "@anthropic-ai/sandbox-runtime": "0.0.81",
    "playwright-core": "^1.64.1",
    "@omacode/tui": "0.1.1"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  }
}

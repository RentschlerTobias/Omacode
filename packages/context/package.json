{
  "name": "@omacode/context",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "description": "Context epochs, memory and token accounting for OpenCode sessions",
  "license": "Apache-2.0",
  "author": "Tobias Rentschler <tobias-rentschler@gmx.de>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RentschlerTobias/Omacode.git",
    "directory": "packages/context"
  },
  "homepage": "https://github.com/RentschlerTobias/Omacode#readme",
  "bugs": {
    "url": "https://github.com/RentschlerTobias/Omacode/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "context",
    "memory",
    "tokens"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "files": [
    "src"
  ],
  "publishConfig": {

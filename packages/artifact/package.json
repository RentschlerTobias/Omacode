{
  "name": "@omacode/artifact",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "description": "Artifact contracts for the Omacode plugins: deck, video, site and image specs",
  "license": "Apache-2.0",
  "author": "Tobias Rentschler <tobias-rentschler@gmx.de>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RentschlerTobias/Omacode.git",
    "directory": "packages/artifact"
  },
  "homepage": "https://github.com/RentschlerTobias/Omacode#readme",
  "bugs": {
    "url": "https://github.com/RentschlerTobias/Omacode/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "artifacts",
    "spec",
    "contracts"
  ],
  "scripts": {
    "prepack": "node ../../scripts/copy-license.mjs",
    "postpack": "node ../../scripts/copy-license.mjs --remove"
  },
  "exports": {
    ".": "./src/index.ts",
    "./spec": "./src/spec.ts",
    "./checks": "./src/checks.ts",
    "./provenance": "./src/provenance.ts",
    "./adapter": "./src/adapter.ts",
    "./quality": "./src/quality.ts",
    "./runner": "./src/runner.ts",
    "./paths": "./src/paths.ts",
    "./png": "./src/png.ts",
    "./storyboard": "./src/storyboard.ts",
    "./qa": "./src/qa.ts",
    "./comfyui": "./src/comfyui.ts",
    "./models": "./src/models.ts",
    "./image-qa": "./src/image-qa.ts",
    "./cloud-image": "./src/cloud-image.ts",
    "./adapters/deck": "./src/adapters/deck.ts",
    "./adapters/deck-project": "./src/adapters/deck-project.ts",
    "./adapters/deck-run": "./src/adapters/deck-run.ts",
    "./adapters/deck-checks": "./src/adapters/deck-checks.ts",
    "./adapters/hyperframes": "./src/adapters/hyperframes.ts",
    "./adapters/video": "./src/adapters/video.ts",
    "./adapters/image": "./src/adapters/image.ts"
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@omacode/sandbox": "0.1.1"
  }
}

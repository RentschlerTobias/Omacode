{
  "name": "@omacode/state",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "description": "The job schema, store, control file and options shared by the TUI and the orchestrator",
  "license": "Apache-2.0",
  "author": "Tobias Rentschler <tobias-rentschler@gmx.de>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RentschlerTobias/Omacode.git",
    "directory": "packages/state"
  },
  "homepage": "https://github.com/RentschlerTobias/Omacode#readme",
  "bugs": {
    "url": "https://github.com/RentschlerTobias/Omacode/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "job-state",
    "schema"
  ],
  "scripts": {
    "prepack": "node ../../scripts/copy-license.mjs",
    "postpack": "node ../../scripts/copy-license.mjs --remove"
  },
  "exports": {
    ".": "./src/state.ts",
    "./store": "./src/store.ts",
    "./control": "./src/control.ts",
    "./schema": "./src/schema.ts",
    "./options": "./src/options.ts",
    "./roles": "./src/roles.ts",
    "./routing": "./src/routing.ts",
    "./picks": "./src/picks.ts",
    "./board": "./src/board.ts"
  },
  "files": [
    "src"
  ],
  "dependencies": {
    "@omacode/core": "0.1.1"
  },
  "publishConfig": {
    "access": "public"
  }

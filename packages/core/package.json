{
  "name": "@omacode/core",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "Shared paths, journal and configuration primitives for the Omacode plugins",
  "license": "Apache-2.0",
  "author": "Tobias Rentschler <tobias-rentschler@gmx.de>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RentschlerTobias/Omacode.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/RentschlerTobias/Omacode#readme",
  "bugs": {
    "url": "https://github.com/RentschlerTobias/Omacode/issues"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "journal",
    "secrets",
    "redaction"
  ],
  "scripts": {
    "prepack": "node ../../scripts/pack-js.mjs",
    "postpack": "node ../../scripts/pack-js.mjs --restore"
  },
  "exports": {
    "./paths": "./src/paths.ts",
    "./journal": "./src/journal.ts",
    "./heldout": "./src/heldout.ts",
    "./secrets": "./src/secrets.ts",
    "./jsonc": "./src/jsonc.ts",
    "./redact-config": "./src/redact-config.ts",
    "./tools": "./src/tools.ts",
    "./registry": "./src/registry.ts",
    "./services": "./src/services.ts",
    "./project": "./src/project.ts",
    "./supervisor": "./src/supervisor.ts",
    "./service-control": "./src/service-control.ts",
    "./telemetry": "./src/telemetry.ts",
    "./main": "./src/main.ts"
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  }
}

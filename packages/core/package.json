{
  "name": "@omacode/core",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "description": "Shared paths, journal and configuration primitives for the Omacode plugins",
  "license": "Apache-2.0",
  "author": "Tobias Rentschler <tobias-rentschler@gmx.de>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RentschlerTobias/Omacode.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/RentschlerTobias/Omacode#readme",
  "bugs": {
    "url": "https://github.com/RentschlerTobias/Omacode/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "journal",
    "secrets",
    "redaction"
  ],
  "scripts": {
    "prepack": "node ../../scripts/copy-license.mjs",
    "postpack": "node ../../scripts/copy-license.mjs --remove"
  },
  "exports": {
    "./journal": "./src/journal.ts",
    "./heldout": "./src/heldout.ts",
    "./secrets": "./src/secrets.ts",
    "./jsonc": "./src/jsonc.ts",
    "./redact-config": "./src/redact-config.ts",
    "./tools": "./src/tools.ts",
    "./registry": "./src/registry.ts"
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  }
}
